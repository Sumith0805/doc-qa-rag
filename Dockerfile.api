# Image for the FastAPI backend (api.py). The existing Dockerfile still builds the Streamlit app.
#   docker build -f Dockerfile.api -t documind-api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Run as a non-root user
RUN useradd -m -u 1000 app && mkdir -p /data && chown app:app /data

# Install dependencies first so Docker can cache this layer
COPY requirements-api.txt .
RUN pip install -r requirements-api.txt

COPY --chown=app:app . .

USER app
ENV HOME=/home/app \
    DOCUMIND_DATA_DIR=/data \
    PORT=8000

# Download the embedding model at build time so the container starts fast
RUN python -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction as E; E()(['warm up'])"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:'+os.environ['PORT']+'/health', timeout=4).status == 200 else 1)"

# ONE worker only: the rate limiter, login lockout and vector-store cache live in process memory.
# Hosts that assign their own port set $PORT; locally it stays 8000.
CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT} --workers 1"]
