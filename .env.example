# Copy to .env and fill in. NEVER commit .env
GROQ_API_KEY=your-groq-key-here

# Optional overrides
# DOCUMIND_LLM=groq          # or "mock" to run without any API key
# DOCUMIND_MIN_SCORE=0.25    # abstention threshold (calibrate with python -m eval.run_eval)
# DOCUMIND_TOP_K=6

# API (v2)
# DOCUMIND_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated frontend URLs for CORS
# DOCUMIND_MAX_UPLOAD_MB=10
# DOCUMIND_MAX_PDF_PAGES=100
# DOCUMIND_MAX_DOCS_PER_USER=20

# Cloud storage (v2): Postgres + pgvector on Neon. Leave unset to keep SQLite + ChromaDB locally.
# DOCUMIND_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host/dbname   # SECRET: put the real value only in .env / Render
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:5433/postgres   # throwaway local Docker DB for tests
